    if(!existeIndependiente(id, c1)) {
      printf("No se pudo aniadirIndependiente: %s\n", id.c_str());
      exit(1);
    }
  }

    for (size_t i = 0; i < 3; i++) {
    id = "t" + to_string(i);
    if (!existeIndependiente(id, c1)) {
      printf("ERROR: testExisteIndependiente\n");
      exit(1);
    }
  }

  id = "taaa";
  if (existeIndependiente(id, c1)) {
    printf("ERROR: testExisteIndependiente\n");
    exit(1);
  }

  printf("PASS: testExisteIndependiente\n");
}

void testExisteDependiente() {

  colecInterdep<string, Evento> c1;
  Evento eventos[5];
  string id, super_id;
  unsigned int n_depen, n;

  n = 5;

  for (size_t i = 0; i < n; i++) {
    crearEvento("Test desc", i, eventos[i]);
  }

  crear(c1);

  // aniadir un elemento que no existe cuyo super no existe
  id = "t0";
  super_id = "dawda";
  aniadirDependiente(c1, id, eventos[0], super_id);
  if(existeDependiente(id, c1)) {
    printf("ERROR: testExisteDependiente - aniadirDependiente 1\n");
    exit(1);
  }

  // Añadimos el nodo super para estas pruebas
  id = "t0";
  aniadirIndependiente(c1, id, eventos[0]);
  if (!existeIndependiente(id, c1)) {
    printf("ERROR: testExisteDependiente - aniadirIndependiente 2\n");
    exit(1);
  }

  // Intentar encadenarse a sí mismo
  id = "t0";
  super_id = "t0";
  aniadirDependiente(c1, id, eventos[0], super_id);
  if (existeDependiente(id, c1)) {
    printf("ERROR: testExisteDependiente - aniadirDependiente 3\n");
    exit(1);
  }

  // aniadir un elemento cuyo super no existe
  id = "t0";
  super_id = "dawda";
  aniadirDependiente(c1, id, eventos[0], super_id);
  if (existeDependiente(id, c1)) {
    printf("ERROR: testExisteDependiente - aniadirDependiente 4\n");
    exit(1);
  }

  super_id = "t0";
  for (size_t i = 1; i < n; i++) {
    id = "t" + to_string(i);
    aniadirDependiente(c1, id, eventos[i], super_id);
    if (!existeDependiente(id, c1)) {
      printf("ERROR: testExisteDependiente - aniadirDependiente 5\n");
      exit(1);
    }
  }

  if (obtenerNumDependientes(super_id, c1, n_depen) && n_depen != n - 1) {
    printf("ERROR: testExisteDependiente - obtenerNumDependientes, expected: %d, obtained: %d\n", n - 1, n_depen);
    exit(1);
  }

  // Comprobar que se han añadido correctamente
  for (size_t i = 1; i < n; i++) {
    id = "t" + to_string(i);
    if (!existeDependiente(id, c1)) {
      printf("ERROR: testExisteDependiente - existeDependiente 6\n");
      exit(1);
    }
  }

  printf("PASS: testExisteDependiente\n");
}

void testaniadirIndependiente() {
  colecInterdep<string, Evento> c1;
  Evento testEvento;
  string id;
  int n = 5;

  crearEvento("Test desc", 20, testEvento);

  crear(c1);

  // Pruebas con 1 elemento
  id = "t0";
  aniadirIndependiente(c1, id, testEvento);
  if (!existeIndependiente(id, c1)) {
    printf("ERROR: testaniadirIndependiente 1\n");
    exit(1);
  }

  if (!existe(id, c1) || tamanio(c1) != 1) {
    printf("ERROR: testaniadirIndependiente 2\n");
    exit(1);
  }

  // aniadir varios

  for (size_t i = 1; i < n; i++) {
    id = "t" + to_string(i);
    aniadirIndependiente(c1, id, testEvento);
    if (!existeIndependiente(id, c1)) {
      printf("ERROR: testaniadirIndependiente 3\n");
      exit(1);
    }
  }
  for (size_t i = 0; i < n; i++) {
    id = "t" + to_string(i);
    if (!existe(id, c1) || tamanio(c1) != n) {
      printf("ERROR: testaniadirIndependiente 4\n");
      exit(1);
    }
  }

  printf("PASS: testaniadirIndependiente\n");
}

