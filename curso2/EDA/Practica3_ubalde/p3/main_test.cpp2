void testObtenerSupervisor() {

  colecInterdep<string, Evento> c1;
  Evento testEvento;
  string id, super_id;
  int n = 5;

  crearEvento("Test desc", 20, testEvento);

  crear(c1);

  // Pruebas con 1 elemento
  id = "t0";
  aniadirIndependiente(c1, id, testEvento);
  if (!existeIndependiente(id, c1)) {
    printf("ERROR: testObtenerSupervisor 1\n");
    exit(1);
  }

  if (!existe(id, c1) || tamanio(c1) != 1) {
    printf("ERROR: testObtenerSupervisor 2\n");
    exit(1);
  }

  // aniadir varios
  super_id = "t0";
  for (size_t i = 1; i < n; i++) {
    id = "t" + to_string(i);
    aniadirDependiente(c1, id, testEvento, super_id);
    if (!existeDependiente(id, c1)) {
      printf("ERROR: testObtenerSupervisor 3\n");
      exit(1);
    }
  }

  for (size_t i = 1; i < n; i++) {
    id = "t" + to_string(i);

    if (!obtenerSupervisor(id, c1, super_id) || super_id != "t0") {
      printf("ERROR: testObtenerSupervisor 4\n");
      exit(1);
    }
  }
  printf("PASS: testObtenerSupervisor\n");
}

void testBorrado() {
  colecInterdep<string, Evento> c1;
  Evento testEvento;
  string id;

  crearEvento("Test desc", 20, testEvento);

  crear(c1);

  // Pruebas con 1 elemento
  id = "t1";
  aniadirIndependiente(c1, id, testEvento);
  if (!existeIndependiente(id, c1)) {
    exit(1);
  }

  if (existe(id, c1)) {
    borrar(id, c1);
    if (existe(id, c1)) {
      printf("No se pudo borrar: %s\n", id.c_str());
      exit(1);
    }
  } else {
    printf("No se pudo borrar: %s\n", id.c_str());
    exit(1);
  }

  // Pruebas con más de 1 elemento
  // Inserción
  for (size_t i = 0; i < 3; i++) {
    id = "t" + to_string(i);
    aniadirIndependiente(c1, id, testEvento);
    if (!existeIndependiente(id, c1)) {
      printf("No se pudo aniadirIndependiente: %s\n", id.c_str());
      exit(1);
    }
  }

  // Borrado
  for (size_t i = 0; i < 3; i++) {
    id = "t" + to_string(i);
    if (existe(id, c1)) {
      borrar(id, c1);
      if (existe(id, c1)) {
        printf("No se pudo borrar: %s\n", id.c_str());
        exit(1);
      }
    } else {
      printf("No se pudo borrar: %s\n", id.c_str());
      exit(1);
    }
  }

  if (esVacia(c1)) {
    printf("PASS: testBorrado\n");
  } else {
    printf("ERROR: testBorrado\n");
    exit(1);
  }
}

void testIterator() {

  colecInterdep<string, Evento> c1;
  Evento testEvento;
  string id, desc;
  int n = 5;

  crear(c1);

  // aniadir varios elementos
  for (size_t i = 0; i < n; i++) {
    id = "t" + to_string(i);
    desc = "Test desc" + to_string(i);
    crearEvento(desc, i, testEvento);
    aniadirIndependiente(c1, id, testEvento);
    if (!existeIndependiente(id, c1)) {
      printf("ERROR: testIterator 1\n");
      exit(1);
    }
  }

  iniciarIterador(c1);

  while (existeSiguiente(c1)) {
    siguienteIdent(c1, id);
    siguienteVal(c1, testEvento);
    mostrarEvento(id, testEvento);
    avanza(c1);
  }

  printf("PASS: testIterator\n");
}

