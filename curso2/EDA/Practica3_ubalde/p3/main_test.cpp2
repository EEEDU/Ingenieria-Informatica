#include <string>
#include "evento.hpp"
#include "colecInterdep.hpp"

using namespace std;

void mostrarEvento(const string &id, const Evento &e) {
  // Utilidad: mostrar un evento formateado junto con su identificador
  printf("Evento[id=%s, desc=\"%s\", prio=%d]\n", id.c_str(), descripcion(e).c_str(), suPrioridad(e));
}

void testHacerDependiente() {

  colecInterdep<string, Evento> c1;
  Evento testEvento;
  string id, super_id;
  int n = 5;

  crearEvento("Test desc", 20, testEvento);

  crear(c1);

   // Hacer dependiente con lista vacía (debe FALLAR => false)
  id = "t0";
  super_id = "t1";

  hacerDependiente(c1, id, super_id);
  if (existeDependiente(id, c1)) {
    printf("ERROR: testHacerDependiente (lista vacía) debería fallar - id: %s, super_id: %s\n", id.c_str(), super_id.c_str());
    exit(1);
  }

  // Introducir n elementos
  for (size_t i = 0; i < n; i++) {
    id = "t" + to_string(i);
    aniadirIndependiente(c1, id, testEvento);
    if (!existeIndependiente(id, c1)) {
      printf("No se pudo testHacerDependiente: %s\n", id.c_str());
      exit(1);
    }
  }

  // Hacer dependiente el primero del segundo
  id = "t0";
  super_id = "t1";
  hacerDependiente(c1, id, super_id);
  if (!existeDependiente(id, c1)) {
    printf("No se pudo testHacerDependiente - id: %s, super_id: %s\n", id.c_str(), super_id.c_str());
    exit(1);
  }

  // Obtener el super del primero
  id = "t0";
  super_id = "";
  if (obtenerSupervisor(id, c1, super_id) && super_id != "t1") {
    printf("ERROR: testHacerDependiente - obtenerSupervisor 1, expected: %s, obtained: %s\n", id.c_str(), super_id.c_str());
    exit(1);
  }

  // Obtener el supervisor de un nodo que es independiente
  id = "t2";
  super_id = "";
  if (!obtenerSupervisor(id, c1, super_id) && super_id != "") {
    printf("ERROR: testHacerDependiente - obtenerSupervisor 2, expected: %s, obtained: %s\n", id.c_str(), super_id.c_str());
    exit(1);
  }

  // Obtener el supervisor de un nodo inexistente
  id = "t3";
  super_id = "";
  if (!obtenerSupervisor(id, c1, super_id) && super_id != "") {
    printf("ERROR: testHacerDependiente - obtenerSupervisor 3, expected: %s, obtained: %s\n", id.c_str(), super_id.c_str());
    exit(1);
  }
  printf("PASS: testHacerDependiente\n");
}

void testHacerIndependiente() {

  colecInterdep<string, Evento> c1;
  Evento eventos[5];
  string id, super_id;
  unsigned int n_depen, n;

  n = 5;

  for (size_t i = 0; i < n; i++) {
    crearEvento("Test desc", i, eventos[i]);
  }

  crear(c1);

  // Añadimos el nodo super para estas pruebas
  id = "t0";
  aniadirIndependiente(c1, id, eventos[0]);
  if (!existeIndependiente(id, c1)) {
    printf("ERROR: testHacerIndependiente - aniadirIndependiente 1\n");
    exit(1);
  }

  super_id = "t0";
  for (size_t i = 1; i < n; i++) {
    id = "t" + to_string(i);
    aniadirDependiente(c1, id, eventos[i], super_id);
    if (!existeDependiente(id, c1)) {
      printf("ERROR: testHacerIndependiente - aniadirDependiente 2\n");
      exit(1);
    }
  }

  for (size_t i = 1; i < n; i++) {
    id = "t" + to_string(i);
    hacerIndependiente(c1, id);
    if (!existeIndependiente(id, c1)) {
      printf("ERROR: testHacerIndependiente - hacerIndependiente 3\n");
      exit(1);
    }
  }

  id = "t3";
  // Hacer independiente algo que ya lo és
  hacerIndependiente(c1, id);
  if (!existeIndependiente(id, c1)) {
    printf("ERROR: testHacerIndependiente - hacerIndependiente 4\n");
    exit(1);
  }

  id = "t0";
  if (!obtenerNumDependientes(id, c1, n_depen) || n_depen != 0) {
    printf("ERROR: testHacerIndependiente - obtenerNumDependientes, expected: 0, obtained: %d\n", n_depen);
    exit(1);
  }

  printf("PASS: testHacerIndependiente\n");
}

void testExiste() {

  colecInterdep<string, Evento> c1;
  Evento testEvento;
  string id;

  crearEvento("Test desc", 20, testEvento);

  crear(c1);

  // Pruebas con más de 1 elemento
  // Inserción
  for (size_t i = 0; i < 3; i++) {
    id = "t" + to_string(i);
    aniadirIndependiente(c1, id, testEvento);
    if(!existeIndependiente(id, c1)) {
      printf("No se pudo aniadirIndependiente: %s\n", id.c_str());
      exit(1);
    }
  }

  for (size_t i = 0; i < 3; i++) {
    id = "t" + to_string(i);
    if (!existe(id, c1)) {
      printf("ERROR: testExiste\n");
      exit(1);
    }
  }

  id = "taaa";
  if (existe(id, c1)) {
    printf("ERROR: testExiste\n");
    exit(1);
  }

  printf("PASS: testExiste\n");
}

void testExisteIndependiente() {
  colecInterdep<string, Evento> c1;
  Evento testEvento;
  string id;

  crearEvento("Test desc", 20, testEvento);

  crear(c1);

  for (size_t i = 0; i < 3; i++) {
