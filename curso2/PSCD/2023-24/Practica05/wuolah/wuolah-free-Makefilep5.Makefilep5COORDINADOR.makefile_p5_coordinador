#         ....
#         Es necesario descomentar la línea 28 para poder compilar en hendrix
#*****************************************************************

#---------------------------------------------------------
CC=g++

MULTI_SERVER=practica_5_COORDINADOR
SOCKET_DIR=Socket
SOCKET=${SOCKET_DIR}/Socket

CPPFLAGS=-I. -I${SOCKET_DIR} -std=c++11 -lsockets # Flags compilacion
LDFLAGS=-pthread # Flags linkado threads

all: ${MULTI_SERVER} 
#----------------------------------------------------------------------------
#Para gestionar opciones de compilación según la máquina: hendrix tiene sus manías
#Descomentar la siguiente línea para compilar en hendrix
SOCKETSFLAGS=-lsocket -lnsl
#-----------------------------------------------------------
# SERVIDOR MULTICLIENTE
# Compilacion
${MULTI_SERVER}.o: ${MULTI_SERVER}.cpp 
	${CC} -c ${CPPFLAGS} ${MULTI_SERVER}.cpp

# Linkado
${MULTI_SERVER}: ${SOCKET}.o ${MULTI_SERVER}.o ControlParejas.o
	${CC} ${LDFLAGS} ${SOCKET}.o ${MULTI_SERVER}.o ControlParejas.o -o ${MULTI_SERVER} ${SOCKETSFLAGS}
#-----------------------------------------------------------
# SOCKETS
# Compilacion libreria de Sockets
${SOCKET}.o: ${SOCKET}.hpp ${SOCKET}.cpp
	${CC} -c ${CPPFLAGS} ${SOCKET}.cpp -o ${SOCKET}.o

#-----------------------------------------------------------
# MONITOR
# Compilacion del monitor
ControlParejas.o: ControlParejas.cpp ControlParejas.hpp
	${CC} -c ControlParejas.cpp -o ControlParejas.o ${CPPFLAGS}
#-----------------------------------------------------------	
# LIMPIEZA
clean:
	$(RM) ${SOCKET}.o
	$(RM) ${MULTI_SERVER} ${MULTI_SERVER}.o ControlParejas.o
