#         !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
#*****************************************************************

CC=g++

CLIENT=Alumno
MULTI_SERVER=ServidorPractica5
SOCKET_DIR=Socket
SOCKET=${SOCKET_DIR}/Socket
#---------------------------------------------------------
MON_LIB=./monitores
MONITOR_SILLA=${MON_LIB}/MonitorSilla
MONITOR_DATOS=${MON_LIB}/MonitorDatos
MONITOR_FINAL=${MON_LIB}/MonitorFinal
#---------------------------------------------------------

CPPFLAGS=-I. -I${SOCKET_DIR} -I${MON_LIB} -std=c++11 -lsockets # Flags compilacion
LDFLAGS=-pthread # Flags linkado threads

all: ${CLIENT} ${MULTI_SERVER} 
#----------------------------------------------------------------------------
#Para gestionar opciones de compilación según la máquina: hendrix tiene sus manías
#Descomentar la siguiente línea para compilar en hendrix
#SOCKETSFLAGS=-lsocket -lnsl
#-----------------------------------------------------------
# CLIENTE
# Compilacion
${CLIENT}.o: ${CLIENT}.cpp
	${CC} -c ${CPPFLAGS} ${CLIENT}.cpp

# Linkado
${CLIENT}: ${SOCKET}.o ${CLIENT}.o  
	${CC} ${LDFLAGS} ${SOCKET}.o ${CLIENT}.o -o ${CLIENT} ${SOCKETSFLAGS}
#-----------------------------------------------------------
# SERVIDOR MULTICLIENTE
# Compilacion
${MULTI_SERVER}.o: ${MULTI_SERVER}.cpp 
	${CC} -c ${CPPFLAGS} ${MULTI_SERVER}.cpp

# Linkado
# ${MULTI_SERVER}: ${SOCKET}.o ${MULTI_SERVER}.o
# 	${CC} ${LDFLAGS} ${SOCKET}.o ${MULTI_SERVER}.o -o ${MULTI_SERVER} ${SOCKETSFLAGS}

${MULTI_SERVER}: ${MULTI_SERVER}.o ${SOCKET}.o ${MONITOR_SILLA}.o ${MONITOR_DATOS}.o ${MONITOR_FINAL}.o
	${CC} ${SOCKET}.o ${MULTI_SERVER}.o ${MONITOR_SILLA}.o ${MONITOR_DATOS}.o ${MONITOR_FINAL}.o -o ${MULTI_SERVER} ${SOCKETSFLAGS} ${LDFLAGS}
#-----------------------------------------------------------
# MONITORES
# Compilacion libreria de monitores
${MONITOR_SILLA}.o: ${MONITOR_SILLA}.hpp ${MONITOR_SILLA}.cpp
	${CC} -c ${MONITOR_SILLA}.cpp -o ${MONITOR_SILLA}.o ${CPPFLAGS}

${MONITOR_DATOS}.o: ${MONITOR_DATOS}.hpp ${MONITOR_DATOS}.cpp
	${CC} -c ${MONITOR_DATOS}.cpp -o ${MONITOR_DATOS}.o ${CPPFLAGS}

${MONITOR_FINAL}.o: ${MONITOR_FINAL}.hpp ${MONITOR_FINAL}.cpp
	${CC} -c ${MONITOR_FINAL}.cpp -o ${MONITOR_FINAL}.o ${CPPFLAGS}

#-----------------------------------------------------------
# SOCKETS
# Compilacion libreria de Sockets
${SOCKET}.o: ${SOCKET}.hpp ${SOCKET}.cpp
	${CC} -c ${CPPFLAGS} ${SOCKET}.cpp -o ${SOCKET}.o
#-----------------------------------------------------------	
# LIMPIEZA
clean:
	$(RM) ${SOCKET}.o
	$(RM) ${CLIENT} ${CLIENT}.o
	$(RM) ${MULTI_SERVER} ${MULTI_SERVER}.o

