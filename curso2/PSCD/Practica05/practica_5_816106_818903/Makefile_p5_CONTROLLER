CC=g++
#----------------------------------------------------------------------------
DIR_LIBS=./librerias
BUFF_LIB=${DIR_LIBS}/MultiBuffer
BUFF=${BUFF_LIB}/MultiBuffer
SOCKET_DIR=Socket
SOCKET=${SOCKET_DIR}/Socket

#----------------------------------------------------------------------------
CLIENT_CONTROL=practica_5_CONTROLLER

CPPFLAGS=-I. -I${SOCKET_DIR} -I${BUFF_LIB} -std=c++11 -lsockets # Flags compilacion
LDFLAGS=-pthread # Flags linkado threads

all: ${CLIENT_CONTROL}
#----------------------------------------------------------------------------
#Para gestionar opciones de compilación según la máquina: hendrix tiene sus manías
#Descomentar la siguiente línea para compilar en hendrix
#SOCKETSFLAGS=-lsocket -lnsl
#-----------------------------------------------------------
# CLIENTE CONTROLADOR
# Compilacion
${CLIENT_CONTROL}.o: ${CLIENT_CONTROL}.cpp
	${CC} -c ${CPPFLAGS} ${CLIENT_CONTROL}.cpp

# Linkado
${CLIENT_CONTROL}: ${SOCKET}.o ${CLIENT_CONTROL}.o 
	${CC} ${LDFLAGS} ${SOCKET}.o ${CLIENT_CONTROL}.o -o ${CLIENT_CONTROL} ${SOCKETSFLAGS}
#-----------------------------------------------------------
# SOCKETS
# Compilacion libreria de Sockets
${SOCKET}.o: ${SOCKET}.hpp ${SOCKET}.cpp
	${CC} -c ${CPPFLAGS} ${SOCKET}.cpp -o ${SOCKET}.o
#-----------------------------------------------------------
# LIMPIEZA
clean:
	$(RM) ${SOCKET}.o
	$(RM) ${CLIENT_CONTROL} ${CLIENT_CONTROL}.o
