#*****************************************************************

CC=g++
#----------------------------------------------------------------------------
DIR_LIBS=./librerias
BUFF_LIB=${DIR_LIBS}/MultiBuffer
BUFF=${BUFF_LIB}/MultiBuffer
SOCKET_DIR=Socket
SOCKET=${SOCKET_DIR}/Socket

#----------------------------------------------------------------------------
SERVER_TASK=practica_5_TASK_SERVER
MONITORBUFFER=ControlBuffer

CPPFLAGS=-I. -I${SOCKET_DIR} -I${BUFF_LIB} -std=c++11 -lsockets # Flags compilacion
LDFLAGS=-pthread # Flags linkado threads

all: ${SERVER_TASK}
#----------------------------------------------------------------------------
#Para gestionar opciones de compilación según la máquina: hendrix tiene sus manías
#Descomentar la siguiente línea para compilar en hendrix
SOCKETSFLAGS=-lsocket -lnsl
#-----------------------------------------------------------
# SERVIDOR TAREAS
# Compilacion
${SERVER_TASK}.o: ${SERVER_TASK}.cpp
	${CC} -c ${CPPFLAGS} ${SERVER_TASK}.cpp

# Linkado
${SERVER_TASK}: ${SOCKET}.o ${SERVER_TASK}.o ${MONITORBUFFER}.o
	${CC} ${SOCKETSFLAGS} ${LDFLAGS} ${SOCKET}.o ${SERVER_TASK}.o ${MONITORBUFFER}.o -o ${SERVER_TASK}
#-----------------------------------------------------------
# SOCKETS
# Compilacion libreria de Sockets
${SOCKET}.o: ${SOCKET}.hpp ${SOCKET}.cpp
	${CC} -c ${CPPFLAGS} ${SOCKET}.cpp -o ${SOCKET}.o
#-----------------------------------------------------------
# MONITORBUFFER
# Compilacion libreria de Monitor Buffer
${MONITORBUFFER}.o: ${MONITORBUFFER}.hpp ${MONITORBUFFER}.cpp
	${CC} -c ${CPPFLAGS} ${MONITORBUFFER}.cpp -o ${MONITORBUFFER}.o
#-----------------------------------------------------------
# LIMPIEZA
clean:
	$(RM) ${SOCKET}.o
	$(RM) ${SERVER_TASK} ${SERVER_TASK}.o
	$(RM) ${MONITORBUFFER} ${MONITORBUFFER}.o
