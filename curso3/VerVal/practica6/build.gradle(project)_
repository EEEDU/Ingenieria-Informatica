// Top-level build file where you can add configuration options common to all sub-projects/modules.
plugins {
    id 'com.android.application' version '8.13.2' apply false
}
ext {
    appCompatVersion = '1.7.0'
    constraintLayoutVersion = '2.2.1'
    coreTestingVersion = '2.2.0'
    lifecycleVersion = '2.8.7'
    materialVersion = '1.12.0'
    roomVersion = '2.6.1'

    // testing
    junit4Version = '4.13.2'
    junit5Version = '5.12.2'
    testCoreVersion = '1.5.0'
    testRunnerVersion = '1.5.2'
    testRulesVersion = testCoreVersion
    espressoVersion = '3.6.1'
    espressoIntentsVersion = espressoVersion
    espressoContribVersion = espressoVersion
    androidxJunitVersion = '1.2.1'
    uiAutomatorVersion = '2.3.0'
    cucumberVersion= '7.14.0'
    cucumberPicoContainerVersion = '7.17.0'

}
